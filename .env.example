# All optional — every value below has a working default in src/lib/site.ts.
# Set them in Vercel (Project → Settings → Environment Variables) to change a
# link without touching the code, then redeploy.

# Discord invite. The one most likely to change, so it lives here.
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/wawatrading

# YouTube channel.
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@cj_wawa

# Lucid Trading referral link. Only set this if the referral URL changes —
# the code already ships with the real one.
NEXT_PUBLIC_LUCID_URL=https://lucidtrading.com/ref/TP

# Canonical site origin, used for link-preview metadata.
NEXT_PUBLIC_SITE_URL=https://takeprofit.tv
